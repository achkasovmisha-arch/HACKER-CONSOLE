void initLock() {
  randomSeed(micros());
  int orderList[5] = {0,1,2,3,4};
  for (int i = 4; i > 0; i--) {
    int j = random(i + 1);
    int tmp = orderList[i]; orderList[i] = orderList[j]; orderList[j] = tmp;
  }
  for (int i = 0; i < 5; i++) {
    lpins[i].displayY = 0; lpins[i].targetY = 0;
    lpins[i].solved = false; lpins[i].order = orderList[i];
  }
  pickSlot = 0;
  pickDisplayX = LOCK_X + LPIN_GAP + LPIN_W / 2;
  nextOrder = 0; lockSolvedCount = 0;
  lockDone = false; lockFail = false;
  liftSlot = -1; liftProgress = 0; liftResult = false;
}

bool processLock() {
  bool changed = false;
  for (int i = 0; i < 5; i++) {
    float diff = lpins[i].targetY - lpins[i].displayY;
    if (abs(diff) > 0.005) { lpins[i].displayY += diff * 0.12; changed = true; }
    else lpins[i].displayY = lpins[i].targetY;
  }
  float targetPickX = LOCK_X + LPIN_GAP + pickSlot * (LPIN_W + LPIN_GAP) + LPIN_W / 2;
  if (abs(pickDisplayX - targetPickX) > 0.5) {
    pickDisplayX += (targetPickX - pickDisplayX) * 0.2; changed = true;
  } else pickDisplayX = targetPickX;
  if (liftSlot >= 0) {
    changed = true;
    liftProgress += 0.06;
    lpins[liftSlot].displayY = liftProgress * 0.7;
    if (liftProgress >= 0.7 && !liftResult) {
      liftResult = true;
      if (lpins[liftSlot].order == nextOrder) {
        lpins[liftSlot].targetY = 1.0; lpins[liftSlot].solved = true;
        nextOrder++; lockSolvedCount++;
        espTone(2000, 60); espTone(2500, 50);
        if (nextOrder >= 5) {
          lockDone = true; doneTimer = millis();
          espTone(1500, 100); delay(80); espTone(2000, 100); delay(80); espTone(2500, 200);
        }
      } else { liftResult = false; }
    }
    if (liftProgress >= 1.0) {
      liftProgress = 0;
      if (lpins[liftSlot].solved) { liftSlot = -1; }
      else {
        lpins[liftSlot].targetY = 0; liftSlot = -1;
        lockFail = true; failTimer = millis(); espTone(200, 300);
        for (int i = 0; i < 5; i++) {
          if (lpins[i].solved) { lpins[i].solved = false; lpins[i].targetY = 0; }
        }
        nextOrder = 0; lockSolvedCount = 0;
      }
    }
  }
  if (lockFail) { changed = true; if (millis() - failTimer > 1200) lockFail = false; }
  if (lockDone) {
    changed = true;
    if (millis() - doneTimer > 1500) { lockLevel++; initLock(); showTextBanner("LVL " + String(lockLevel)); }
  }
  if (liftSlot < 0 && !lockFail && !lockDone && key != 0) {
    if (key == '4') { if (pickSlot > 0) { pickSlot--; click(); changed = true; } }
    else if (key == '6') { if (pickSlot < 4) { pickSlot++; click(); changed = true; } }
    else if (key == '5') {
      if (!lpins[pickSlot].solved) { liftSlot = pickSlot; liftProgress = 0; liftResult = false; espTone(800, 30); changed = true; }
    }
  }
  return changed;
}

