  for (int r = 18; r <= 22; r += 2) tft.drawCircle(cx, cy, r, COL_DIM);
  tft.drawCircle(cx, cy - 4, 7, COL_HEADER);
  tft.drawCircle(cx, cy - 4, 6, COL_HEADER);
  tft.fillRect(cx - 10, cy - 5, 20, 4, BLACK);
  tft.fillRoundRect(cx - 12, cy - 2, 24, 18, 3, COL_HEADER);
  tft.drawRoundRect(cx - 12, cy - 2, 24, 18, 3, COL_TEXT);
  tft.fillCircle(cx, cy + 5, 2, BLACK);
  tft.fillRect(cx - 1, cy + 5, 2, 6, BLACK);
  if (lockAnimPhase == 0) tft.drawCircle(cx, cy, 24, COL_HEADER);
  else if (lockAnimPhase == 1) tft.drawCircle(cx, cy, 25, COL_TEXT);
  tft.drawFastHLine(30, 72, 100, COL_DIM);
  tft.setTextColor(COL_TEXT); tft.setTextSize(1);
  tft.setCursor(52, 78); tft.print("ENTER PIN");
  for (int i = 0; i < 4; i++) {
    int dx = 50 + i * 20, dy = 95;
    if (i < pinInput.length()) {
      tft.fillCircle(dx, dy, 4, COL_HEADER);
      tft.drawCircle(dx, dy, 5, COL_TEXT);
