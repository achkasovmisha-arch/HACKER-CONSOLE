    } else if (i == crackPos && !crackDone) {
      uint16_t borderCol = crackWrong ? RED : ((millis() / 250) % 2 ? COL_HEADER : COL_TEXT);
      tft.fillRoundRect(cx - 1, cellY - 1, CRACK_CELL_W + 2, CRACK_CELL_W + 2, 3, borderCol);
      tft.fillRoundRect(cx, cellY, CRACK_CELL_W, CRACK_CELL_W, 2, BLACK);
      tft.drawRoundRect(cx, cellY, CRACK_CELL_W, CRACK_CELL_W, 2, COL_TEXT);
