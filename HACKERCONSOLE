void loop() {
  server.handleClient();
  char k = kp.getKey();
  if (k != NO_KEY) { key = k; click(); }

  if (md == 0) {
    if (millis() - lockAnimTimer > 500) {
      lockAnimTimer = millis();
      lockAnimPhase = (lockAnimPhase + 1) % 2;
      drawLockScreen();
    }
    if (clearOnce) { drawLockScreen(); clearOnce = false; }
    if (pinWrong && millis() - wrongTimer > 1200) {
      pinWrong = false; pinInput = ""; drawLockScreen();
    }
    if (key >= '0' && key <= '9') {
      if (pinInput.length() < 4 && !pinWrong) {
        pinInput += key; drawLockScreen(); espTone(1500, 30);
      }
    }
    if (key == '*') { pinInput = ""; pinWrong = false; drawLockScreen(); }
    if (key == '#') {
      if (pinInput == LOCK_PIN) {
        md = 1; clearOnce = true; drawMenu(); espTone(2000, 100);
      } else {
        pinWrong = true; wrongTimer = millis();
        drawLockScreen(); espTone(200, 200);
      }
    }
  } else if (md == 1) {
    if (key == 'A' && menuPage == 0) { md = 11; clearOnce = true; }
    if (key == 'D' && menuPage == 0) {
      md = 0; pinInput = ""; pinWrong = false;
      lockAnimTimer = millis(); lockAnimPhase = 0; clearOnce = true;
    }
    if (menuPage == 0) {
      if (key == '2') { if (sel >= 3) sel -= 3; else sel += 6; drawMenu(); }
      if (key == '8') {
        if (sel < 6) { sel += 3; drawMenu(); }
        else { menuPage = 1; sel = 0; drawMenu(); }
      }
      if (key == '4') { if (sel % 3 > 0) sel--; else sel += 2; drawMenu(); }
      if (key == '6') { if (sel % 3 < 2) sel++; else sel -= 2; drawMenu(); }
      if (key == '5') {
        if (sel == 9) { md = 11; clearOnce = true; }
        else { md = 2 + sel; clearOnce = true; }
      }
    } else {
      if (key == '2') {
        if (sel >= 3) { sel -= 3; drawMenu(); }
        else { menuPage = 0; sel = 6; drawMenu(); }
      }
      if (key == '8') {
        if (sel < 6) { sel += 3; drawMenu(); }
        else { menuPage = 0; sel = 0; drawMenu(); }
      }
      if (key == '4') { if (sel > 0) sel--; else sel = 8; drawMenu(); }
      if (key == '6') { if (sel < 8) sel++; else sel = 0; drawMenu(); }
      if (key == '5') {
        if (sel == 0) { md = 13; clearOnce = true; lockLevel = 1; initLock(); }
        else if (sel == 1) { md = 14; clearOnce = true; crackLevel = 1; initCrack(); }
        else if (sel == 2) { md = 15; clearOnce = true; initSnake(); }
        else if (sel == 3) { md = 16; clearOnce = true; initReact(); }
        else if (sel == 4) { md = 17; clearOnce = true; diceVal[0]=1; diceVal[1]=1; }
        else if (sel == 5) { md = 18; clearOnce = true; initSimon(); }
        else if (sel == 6) { md = 19; clearOnce = true; }
        else if (sel == 7) { md = 20; clearOnce = true; }
        else if (sel == 8) { md = 21; clearOnce = true; }
      }
    }
  } else if (md == 11) {
    if (key == '*') { md = 1; drawMenu(); }
    else { app_theme(); }
  } else {
    if (key == '*') { md = 1; drawMenu(); }
    else {
      switch (md) {
        case 2:  app_radar();   break;
        case 3:  app_ap();      break;
        case 4:  app_scan();    break;
        case 5:  app_hack();    break;
        case 6:  app_term();    break;
        case 7:  app_capture(); break;
        case 8:  app_console(); break;
        case 9:  app_matrix();  break;
        case 10: app_gallery(); break;
        case 13: app_lockpick(); break;
        case 14: app_crack();    break;
        case 15: app_snake();    break;
        case 16: app_react();    break;
        case 17: app_dice();     break;
        case 18: app_simon();    break;
        case 19: app_calc();     break;
        case 20: app_flappy();   break;
        case 21: app_notes();    break;
      }
    }
  }

  if (bannerActive) {
    if (millis() >= ipBannerUntil) {
      bannerActive = false; clearOnce = true;
      if (md == 1) drawMenu();
      else if (md == 0) drawLockScreen();
    }
  }

  static unsigned long lastTimeUpdate = 0;
  if (millis() - lastTimeUpdate > 1000) {
    lastTimeUpdate = millis();
    if (md == 1) {
      tft.fillRect(76, 0, 84, 12, COL_HEADER);
      tft.setTextColor(BLACK); tft.setTextSize(1);
      tft.setCursor(80, 3);
      tft.print(menuPage == 0 ? "1/2" : "2/2");
      tft.setCursor(110, 3); tft.print(getTimeStr());
    } else if (md == 0 && !pinWrong) {
      tft.fillRect(60, 0, 50, 10, BLACK);
      tft.setTextColor(COL_HEADER); tft.setTextSize(1);
      String t = getTimeStr();
      int tw = t.length() * 6;
      tft.setCursor(80 - tw / 2, 2); tft.print(t);
    }
  }

  key = 0;

  if (bannerActive && millis() < ipBannerUntil) {
    tft.fillRect(0, 0, 160, 16, COL_BANNER);
    tft.setTextColor(BLACK); tft.setTextSize(1);
    tft.setCursor(4, 4);
    tft.print(bannerText.substring(0, 20));
  }
