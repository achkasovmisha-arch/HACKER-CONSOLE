void radar_scan() {
  int n = WiFi.scanNetworks();
  netCount = (n < 20) ? n : 20;
  for (int i = 0; i < netCount; i++) {
    nets[i].ssid = WiFi.SSID(i);
    nets[i].rssi = WiFi.RSSI(i);
    float norm = constrain((nets[i].rssi + 95) / 65.0, 0.15, 1.0);
    nets[i].radius = (int)(norm * 55);
    nets[i].angle = i * 360.0 / max(1, netCount);
  }
  WiFi.scanDelete();
}
void radar_base(bool full) {
  if (full) {
    tft.fillScreen(BLACK);
    for (int x = 0; x <= 160; x += 10) tft.drawLine(x, 0, x, 128, COL_DIM);
    for (int y = 0; y <= 128; y += 10) tft.drawLine(0, y, 160, y, COL_DIM);
    for (int r = 55; r >= 15; r -= 15) tft.drawCircle(80, 60, r, COL_DIM);
    tft.drawLine(25, 60, 135, 60, COL_DIM);
    tft.drawLine(80, 5, 80, 115, COL_DIM);
    for (int a = 0; a < 8; a++) {
      float rad = (a * 45.0) * PI / 180.0;
      tft.drawLine(80, 60, 80 + (int)(55*cos(rad)), 60 - (int)(55*sin(rad)), COL_DIM);
    }
    prevX = -1; prevY = -1;
  }
  float rad = sweepAngle * PI / 180.0;
  int newX = 80 + (int)(60*cos(rad));
  int newY = 60 - (int)(60*sin(rad));
  tft.drawLine(80, 60, newX, newY, COL_HEADER);
  prevX = newX; prevY = newY;
}
void radar_targets() {
  bool pulse = (millis()/200)%2;
  for (int i = 0; i < netCount; i++) {
    float rad = nets[i].angle * PI / 180.0;
    int px = 80 + (int)(nets[i].radius*cos(rad));
    int py = 60 - (int)(nets[i].radius*sin(rad));
    uint16_t c = (nets[i].rssi>=-55)?COL_HEADER:((nets[i].rssi>=-70)?YEL:RED);
    tft.fillCircle(px, py, pulse?4:3, c);
    tft.drawCircle(px, py, 6, c);
  }
  tft.setTextSize(1); tft.setTextColor(COL_HEADER); tft.setCursor(6,3); tft.print("RADAR");
  tft.setTextColor(COL_TEXT); tft.setCursor(6,13); tft.print("T:"); tft.print(netCount);
}
void app_radar() {
  if (bannerActive) return;
  if (clearOnce) { radar_scan(); radar_base(true); clearOnce = false; }
  if (millis()-lastScan > 10000) { lastScan = millis(); radar_scan(); }
  if (millis()-lastSweep > 30) {
    lastSweep = millis();
    sweepAngle += 3;
    bool fullCircle = false;
    if (sweepAngle >= 360) { sweepAngle = 0; fullCircle = true; }
    radar_base(fullCircle);
    radar_targets();
  }
}

