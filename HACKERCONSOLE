}

void drawAppIcon(int idx, int ix, int iy, bool selected) {
  int cx = ix + 12, cy = iy + 12;
  uint16_t bg, fg;
  switch (idx) {
    case 0: bg = 0x0220; fg = GREEN;  break;
    case 1: bg = 0x021F; fg = CYN;    break;
    case 2: bg = 0x4208; fg = YEL;    break;
    case 3: bg = 0x4000; fg = RED;    break;
    case 4: bg = 0x0220; fg = GREEN;  break;
    case 5: bg = 0x7800; fg = MAG;    break;
    case 6: bg = 0x021F; fg = CYN;    break;
    case 7: bg = 0x0120; fg = GREEN;  break;
    case 8: bg = 0x6200; fg = ORANGE; break;
    case 9: bg = 0x4220; fg = YEL;    break;
    case 10: bg = 0x3220; fg = LGOLD; break;
    case 11: bg = 0x3000; fg = ORANGE; break;
    case 12: bg = 0x0220; fg = GREEN;  break;
    case 13: bg = 0x4220; fg = YEL;    break;
    case 14: bg = 0x4210; fg = WHITE;  break;
    case 15: bg = 0x0210; fg = CYN;    break;
    case 16: bg = 0x2104; fg = CYN;    break;
    case 17: bg = 0x0220; fg = YEL;    break;
    case 18: bg = 0x0220; fg = GREEN;  break;
    default: bg = GREY;   fg = WHITE;
  }
  if (selected) tft.fillRoundRect(ix - 3, iy - 3, 30, 30, 5, fg);
  tft.fillRoundRect(ix, iy, 24, 24, 3, bg);
  tft.drawRoundRect(ix, iy, 24, 24, 3, fg);
  tft.setTextColor(fg);
  switch (idx) {
    case 0:
      tft.drawCircle(cx, cy, 8, fg);
      tft.drawLine(cx, cy, cx + 6, cy - 5, fg);
      tft.fillCircle(cx, cy, 1, fg);
      break;
    case 1: tft.setTextSize(2); tft.setCursor(cx - 6, cy - 8); tft.print("W"); break;
    case 2:
      tft.drawCircle(cx - 2, cy - 1, 6, fg);
      tft.drawLine(cx + 3, cy + 4, cx + 7, cy + 8, fg);
      break;
    case 3: tft.setTextSize(2); tft.setCursor(cx - 6, cy - 8); tft.print("H"); break;
    case 4: tft.setTextSize(2); tft.setCursor(cx - 6, cy - 8); tft.print(">"); break;
    case 5: tft.setTextSize(1); tft.setCursor(cx - 6, cy - 4); tft.print("IP"); break;
    case 6: tft.setTextSize(2); tft.setCursor(cx - 6, cy - 8); tft.print("#"); break;
    case 7: tft.setTextSize(1); tft.setCursor(cx - 6, cy - 4); tft.print("01"); break;
    case 8:
      tft.drawRect(cx - 8, cy - 6, 16, 12, fg);
      tft.fillRect(cx - 6, cy - 4, 12, 2, fg);
      tft.fillCircle(cx - 3, cy + 2, 2, fg);
      break;
    case 9: tft.setTextSize(2); tft.setCursor(cx - 6, cy - 8); tft.print("T"); break;
    case 10:
      tft.fillCircle(cx, cy - 4, 5, fg);
      tft.fillRect(cx - 5, cy - 1, 10, 10, fg);
      tft.fillRect(cx - 2, cy + 2, 4, 6, BLACK);
      break;
    case 11:
      tft.drawCircle(cx, cy, 8, fg);
      tft.fillCircle(cx, cy, 6, bg);
      tft.drawFastVLine(cx, cy - 5, 4, fg);
      tft.fillCircle(cx, cy, 1, fg);
      tft.drawFastHLine(cx - 7, cy + 7, 14, fg);
      break;
    case 12:
      tft.drawFastHLine(cx - 7, cy - 5, 6, fg);
      tft.drawFastVLine(cx - 1, cy - 5, 6, fg);
      tft.drawFastHLine(cx - 1, cy + 1, 8, fg);
      tft.fillCircle(cx + 7, cy + 1, 1, fg);
      break;
    case 13:
      tft.fillTriangle(cx - 1, cy - 7, cx + 5, cy - 7, cx, cy - 1, fg);
      tft.fillTriangle(cx - 4, cy + 1, cx + 2, cy + 1, cx - 2, cy + 7, fg);
      break;
    case 14:
      tft.fillCircle(cx - 4, cy - 4, 2, fg);
      tft.fillCircle(cx + 4, cy + 4, 2, fg);
      tft.fillCircle(cx, cy, 2, fg);
      break;
    case 15:
      tft.fillRect(cx - 7, cy - 7, 6, 6, RED);
      tft.fillRect(cx + 1, cy - 7, 6, 6, GREEN);
      tft.fillRect(cx - 7, cy + 1, 6, 6, YEL);
      tft.fillRect(cx + 1, cy + 1, 6, 6, CYN);
      break;
    case 16:
      tft.drawRect(cx - 7, cy - 8, 14, 16, fg);
      tft.fillRect(cx - 5, cy - 6, 10, 3, fg);
      tft.fillCircle(cx - 3, cy + 1, 1, fg);
      tft.fillCircle(cx + 1, cy + 1, 1, fg);
      tft.fillCircle(cx + 5, cy + 1, 1, fg);
      tft.fillCircle(cx - 3, cy + 5, 1, fg);
      tft.fillCircle(cx + 1, cy + 5, 1, fg);
      tft.fillCircle(cx + 5, cy + 5, 1, fg);
      break;
    case 17:
      tft.fillCircle(cx, cy, 6, YEL);
      tft.fillTriangle(cx + 4, cy, cx + 8, cy - 2, cx + 8, cy + 2, RED);
      tft.fillCircle(cx + 2, cy - 2, 1, BLACK);
      tft.fillCircle(cx - 3, cy + 2, 3, ORANGE);
      break;
    case 18:
      tft.fillRect(cx - 6, cy - 8, 12, 16, fg);
      tft.drawRect(cx - 6, cy - 8, 12, 16, WHITE);
      tft.drawFastHLine(cx - 3, cy - 4, 6, WHITE);
      tft.drawFastHLine(cx - 3, cy - 1, 6, WHITE);
      tft.drawFastHLine(cx - 3, cy + 2, 6, WHITE);
      tft.drawFastHLine(cx - 3, cy + 5, 4, WHITE);
      break;
  }
}

