bool processSnake() {
  if (snakeDead) { if (key == '5') { initSnake(); return true; } return false; }
  if (key == '2' && snakeDir != 1) snakeDir = 3;
  else if (key == '8' && snakeDir != 3) snakeDir = 1;
  else if (key == '4' && snakeDir != 0) snakeDir = 2;
  else if (key == '6' && snakeDir != 2) snakeDir = 0;
  if (millis() - snakeLastMove < SNAKE_SPEED) return false;
  snakeLastMove = millis();
  int nx = snakeX[0], ny = snakeY[0];
  if (snakeDir == 0) nx++;
  else if (snakeDir == 1) ny++;
  else if (snakeDir == 2) nx--;
  else if (snakeDir == 3) ny--;
  if (nx < 0 || nx >= SNAKE_GRID_W || ny < 0 || ny >= SNAKE_GRID_H) { snakeDead = true; espTone(200, 300); return true; }
  for (int i = 0; i < snakeLen; i++) {
    if (snakeX[i] == nx && snakeY[i] == ny) { snakeDead = true; espTone(200, 300); return true; }
  }
  for (int i = snakeLen; i > 0; i--) { snakeX[i] = snakeX[i-1]; snakeY[i] = snakeY[i-1]; }
  snakeX[0] = nx; snakeY[0] = ny;
  if (nx == foodX && ny == foodY) {
    snakeLen++; snakeScore += 10;
    foodX = random(1, SNAKE_GRID_W-1); foodY = random(1, SNAKE_GRID_H-1);
    espTone(2000, 50);
  }
  return true;
}

