    case 3: tft.fillCircle(cx-o,cy-o,r,BLACK); tft.fillCircle(cx,cy,r,BLACK); tft.fillCircle(cx+o,cy+o,r,BLACK); break;
    case 4: tft.fillCircle(cx-o,cy-o,r,BLACK); tft.fillCircle(cx+o,cy-o,r,BLACK);
            tft.fillCircle(cx-o,cy+o,r,BLACK); tft.fillCircle(cx+o,cy+o,r,BLACK); break;
    case 5: tft.fillCircle(cx-o,cy-o,r,BLACK); tft.fillCircle(cx+o,cy-o,r,BLACK); tft.fillCircle(cx,cy,r,BLACK);
            tft.fillCircle(cx-o,cy+o,r,BLACK); tft.fillCircle(cx+o,cy+o,r,BLACK); break;
    case 6: tft.fillCircle(cx-o,cy-o,r,BLACK); tft.fillCircle(cx+o,cy-o,r,BLACK);
            tft.fillCircle(cx-o,cy,r,BLACK); tft.fillCircle(cx+o,cy,r,BLACK);
