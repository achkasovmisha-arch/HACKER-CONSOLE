void handleSetTime() {
  if (server.hasArg("t")) {
    time_t t = (time_t)server.arg("t").toInt();
    timeval tv = { t, 0 };
    settimeofday(&tv, nullptr);
    timeSynced = true;
    struct tm* lt = localtime(&t);
    char buf[9];
    sprintf(buf, "%02d:%02d:%02d", lt->tm_hour, lt->tm_min, lt->tm_sec);
    showTextBanner("SYNC " + String(buf));
    espTone(2000, 100);
  }
  server.send(200, "text/plain", "OK");
}

void handleSetColor() {
  if (!server.hasArg("c")) { server.send(400, "text/plain", "Missing 'c'"); return; }
  String c = server.arg("c"); c.trim();
  if (c.length() != 4) { server.send(400, "text/plain", "Need 4 hex"); return; }
  uint16_t val = 0; bool ok = true;
  for (int i = 0; i < 4; i++) {
    char ch = c[i]; uint8_t digit;
    if (ch >= '0' && ch <= '9') digit = ch - '0';
    else if (ch >= 'A' && ch <= 'F') digit = ch - 'A' + 10;
    else if (ch >= 'a' && ch <= 'f') digit = ch - 'a' + 10;
    else { ok = false; break; }
    val = (val << 4) | digit;
  }
  if (!ok) { server.send(400, "text/plain", "Invalid hex"); return; }
  COL_BANNER = val;
  server.send(200, "text/plain", "OK");
}

void handleUploadImg() {
  if (!server.hasArg("data")) { server.send(400, "text/plain", "No data"); return; }
  String data = server.arg("data");
  if (data.length() < IMG_PIX * 4) { server.send(400, "text/plain", "Too short"); return; }
  int idx = imgCount % 5;
  for (int i = 0; i < IMG_PIX; i++) {
    uint16_t val = 0;
    for (int j = 0; j < 4; j++) {
      val <<= 4;
      char ch = data[i * 4 + j];
      if (ch >= '0' && ch <= '9') val |= (ch - '0');
      else if (ch >= 'A' && ch <= 'F') val |= (ch - 'A' + 10);
      else if (ch >= 'a' && ch <= 'f') val |= (ch - 'a' + 10);
    }
    imgBuf[idx][i] = val;
  }
  imgCount++;
  showTextBanner("IMG SAVED!");
  espTone(2000, 100);
  server.send(200, "text/plain", "OK");
}

