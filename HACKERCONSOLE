bool processFB() {
  if (fbDead) {
    if (key == '5') { initFB(); return true; }
    return false;
  }
  if (millis() - fbLastUpdate < 33) return false;
  fbLastUpdate = millis();
  if (!fbStarted) {
    if (key == '5') { fbStarted = true; fbBirdVY = FB_FLAP; espTone(1200, 30); }
    else {
      fbBirdY = 55 + sin(millis() / 200.0) * 4;
      fbBgOffset = (fbBgOffset + 1) % 160;
      if (millis() - fbWingTimer > 200) { fbWingTimer = millis(); fbWingPhase = !fbWingPhase; }
      return true;
    }
  }
  if (key == '5') { fbBirdVY = FB_FLAP; espTone(1200, 30); }
  fbBirdVY += FB_GRAVITY;
  fbBirdY += fbBirdVY;
  if (fbBirdY < FB_TOP_Y + 2) { fbBirdY = FB_TOP_Y + 2; fbBirdVY = 0; }
  if (fbBirdY + 5 >= FB_GROUND_Y) {
    fbBirdY = FB_GROUND_Y - 5;
    fbDead = true;
    if (fbScore > fbHighScore) fbHighScore = fbScore;
    espTone(200, 300);
    return true;
  }
  if (millis() - fbWingTimer > 150) { fbWingTimer = millis(); fbWingPhase = !fbWingPhase; }
  for (int i = 0; i < 4; i++) {
    fbPipesX[i] -= fbPipeSpeed;
    if (fbPipesX[i] < -FB_PIPE_W) {
      fbPipesX[i] = 160;
      fbPipesGapY[i] = random(28, 76);
      fbPipeScored[i] = false;
    }
    if (!fbPipeScored[i] && fbPipesX[i] + FB_PIPE_W < FB_BIRD_X) {
      fbPipeScored[i] = true;
      fbScore++;
      espTone(2000, 40);
    }
    int px = fbPipesX[i];
    int gapTop = fbPipesGapY[i] - FB_PIPE_GAP / 2;
    int gapBot = fbPipesGapY[i] + FB_PIPE_GAP / 2;
    if (px + FB_PIPE_W > FB_BIRD_X - 4 && px < FB_BIRD_X + 4) {
      if (fbBirdY - 5 < gapTop || fbBirdY + 5 > gapBot) {
        fbDead = true;
        if (fbScore > fbHighScore) fbHighScore = fbScore;
        espTone(200, 300);
        return true;
      }
    }
  }
  fbBgOffset = (fbBgOffset + fbPipeSpeed) % 160;
  if (fbScore > 0 && fbScore % 5 == 0 && fbPipeSpeed < 4) {
    if (fbScore == 5) fbPipeSpeed = 3;
    if (fbScore == 15) fbPipeSpeed = 4;
  }
  return true;
}

