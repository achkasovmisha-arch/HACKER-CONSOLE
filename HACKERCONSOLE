      tft.setCursor(cx + 5, cellY + 4); tft.print("?");
    }
  }
  if (!crackDone && !crackWrong && crackPos < codeLen) {
    int ax = startX + crackPos * (CRACK_CELL_W + CRACK_CELL_GAP) + CRACK_CELL_W / 2;
    tft.fillTriangle(ax - 2, cellY - 3, ax + 2, cellY - 3, ax, cellY - 1, COL_HEADER);
  }
  int dotSpacing = 8;
  int dotsTotalW = codeLen * dotSpacing;
  int dotStartX = 80 - dotsTotalW / 2 + dotSpacing / 2;
  for (int i = 0; i < codeLen; i++) {
    int dotX = dotStartX + i * dotSpacing;
    if (crackSolved[i]) tft.fillCircle(dotX, 102, 2, GREEN);
    else if (i == crackPos) tft.fillCircle(dotX, 102, 2, COL_HEADER);
    else tft.drawCircle(dotX, 102, 2, COL_DIM);
  }
