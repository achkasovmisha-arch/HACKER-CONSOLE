    tft.fillRoundRect(30, 42, 100, 28, 5, RED);
    tft.drawRoundRect(30, 42, 100, 28, 5, WHITE);
    tft.setTextColor(WHITE); tft.setTextSize(2);
    tft.setCursor(42, 49); tft.print("WRONG");
  }
}

bool processCrack() {
  bool changed = false;
  float diff = crackBoltTarget - crackBoltExtend;
  if (abs(diff) > 0.5) { crackBoltExtend += diff * 0.15; changed = true; }
  else crackBoltExtend = crackBoltTarget;
  if (crackWrong && millis() - crackWrongTimer > 800) { crackWrong = false; changed = true; }
  if (crackDone && millis() - crackDoneTimer > 1500) {
    crackLevel++; initCrack(); showTextBanner("LVL " + String(crackLevel)); return true;
  }
  if (!crackDone && !crackWrong && crackPos < codeLen && key != 0) {
    if (key == '2') { tryDigit = (tryDigit + 1) % 10; click(); changed = true; }
    else if (key == '8') { tryDigit = (tryDigit + 9) % 10; click(); changed = true; }
    else if (key == '#') {
      crackAttempts++;
      if (tryDigit == codeDigits[crackPos]) {
        crackSolved[crackPos] = true; crackPos++; tryDigit = 0;
        crackBoltTarget = ((float)crackPos / codeLen) * CRACK_BOLT_MAX_EXT;
        espTone(2000, 60); espTone(2500, 50); changed = true;
        if (crackPos >= codeLen) {
          crackDone = true; crackDoneTimer = millis();
          crackBoltTarget = CRACK_BOLT_MAX_EXT;
          espTone(1500, 100); delay(80); espTone(2000, 100); delay(80); espTone(2500, 200);
        }
      } else {
        crackWrong = true; crackWrongTimer = millis(); espTone(200, 200); changed = true;
      }
    }
  }
  return changed;
}

void app_crack() {
  if (bannerActive) return;
  if (clearOnce) { drawCrackLock(); clearOnce = false; return; }
  bool changed = processCrack();
  static unsigned long pulseTimer = 0;
  if (!crackDone && !crackWrong && millis() - pulseTimer > 250) { pulseTimer = millis(); changed = true; }
  if (changed) drawCrackLock();
}

