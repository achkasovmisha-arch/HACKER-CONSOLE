    tft.drawTriangle(CRACK_LOCK_X - ext, boltY, CRACK_LOCK_X - ext, boltY + CRACK_BOLT_THICK, CRACK_LOCK_X - ext - 5, boltY + CRACK_BOLT_THICK / 2, WHITE);
  }
  int totalW = codeLen * CRACK_CELL_W + (codeLen - 1) * CRACK_CELL_GAP;
  int startX = CRACK_LOCK_X + (CRACK_LOCK_W - totalW) / 2;
