String getTimeStr() {
  time_t now = time(nullptr);
  if (now < 1700000000) {
    unsigned long sec = millis() / 1000;
    int h = (sec / 3600) % 100;
    int m = (sec / 60) % 60;
    int s = sec % 60;
    char buf[9];
    sprintf(buf, "%02d:%02d:%02d", h, m, s);
    return String(buf);
  }
  struct tm* t = localtime(&now);
  char buf[9];
  sprintf(buf, "%02d:%02d:%02d", t->tm_hour, t->tm_min, t->tm_sec);
  return String(buf);
}

void espTone(int f, int d) {
  ledcSetup(0, f, 10);
  ledcAttachPin(16, 0);
  ledcWrite(0, 512);
  delay(d);
  ledcWrite(0, 0);
}
