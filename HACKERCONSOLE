void drawImage(int idx) {
  if (idx < 0 || idx >= 5) return;
  for (int y = 0; y < IMG_H; y++) {
    for (int x = 0; x < IMG_W; x++) {
      uint16_t c = imgBuf[idx][y * IMG_W + x];
      tft.fillRect(x * 4, y * 4, 4, 4, c);
    }
  }
}

