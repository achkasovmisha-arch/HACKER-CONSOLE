int calcFindOp(String e, int from) {
  for (int i = from; i < (int)e.length(); i++) {
    char ch = e[i];
    if ((ch == '+' || ch == '-' || ch == 'x' || ch == '/') && i > from) return i;
  }
  return -1;
}

void calcDoEqual() {
  if (calcExpr.length() == 0) return;
  String expr = calcExpr;
  expr.replace("x", "*");
  double result = 0;
  int opPos = calcFindOp(expr, 0);
  if (opPos < 0) {
    result = expr.toDouble();
  } else {
    double left = expr.substring(0, opPos).toDouble();
    char op = expr[opPos];
    String rightStr = expr.substring(opPos + 1);
    int op2 = calcFindOp(rightStr, 0);
    if (op2 >= 0) rightStr = rightStr.substring(0, op2);
    double right = rightStr.toDouble();
    if (op == '+') result = left + right;
    else if (op == '-') result = left - right;
    else if (op == '*') result = left * right;
    else if (op == '/') {
      if (right == 0) { calcError = true; return; }
      result = left / right;
    }
  }
  calcResult = result;
  calcShowResult = true;
  espTone(2000, 50);
}

void app_calc() {
  if (bannerActive) return;
  bool redraw = clearOnce;
  if (clearOnce) { calcCurR = 3; calcCurC = 1; clearOnce = false; }
  if (key == '2') { if (calcCurR > 0) calcCurR--; else calcCurR = 3; click(); redraw = true; }
  if (key == '8') { if (calcCurR < 3) calcCurR++; else calcCurR = 0; click(); redraw = true; }
  if (key == '4') { if (calcCurC > 0) calcCurC--; else calcCurC = 3; click(); redraw = true; }
  if (key == '6') { if (calcCurC < 3) calcCurC++; else calcCurC = 0; click(); redraw = true; }
  if (key == '5') {
    click();
    const char* sym = calcBtns[calcCurR][calcCurC];
    if (calcShowResult || calcError) { calcExpr = ""; calcShowResult = false; calcError = false; }
    if (strcmp(sym, "=") == 0) {
      calcDoEqual();
    } else if (strcmp(sym, ".") == 0) {
      bool hasDot = false;
      int lastOp = -1;
      for (int i = calcExpr.length() - 1; i >= 0; i--) {
        char ch = calcExpr[i];
        if (ch == '+' || ch == '-' || ch == 'x' || ch == '/') { lastOp = i; break; }
        if (ch == '.') hasDot = true;
      }
      if (!hasDot) {
        if (calcExpr.length() == 0 || lastOp == (int)(calcExpr.length() - 1)) {
          calcExpr += "0.";
        } else {
          calcExpr += ".";
        }
      }
    } else {
      calcExpr += sym;
    }
    redraw = true;
  }
  if (key == 'C') {
    calcExpr = ""; calcShowResult = false; calcError = false;
    click(); redraw = true;
  }
  if (key == 'D') { calcDoEqual(); redraw = true; }
  if (key == 'A') {
    calcExpr = ""; calcShowResult = false; calcError = false;
    click(); redraw = true;
  }
  if (redraw) drawCalcScreen();
}

